digraph tb32hv {
  bgcolor="#0b0e14";
  rankdir=TB;
  nodesep=0.45; ranksep=0.55;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        color="#3b4261", fillcolor="#161a24", fontcolor="#c0caf5", margin="0.18,0.09"];
  edge [fontname="Helvetica", fontsize=9, color="#565f89", fontcolor="#7c85b0"];

  subgraph cluster_guest {
    label="Guest VM: unmodified, de-privileged, one per partition";
    labelloc="t"; fontname="Helvetica"; fontsize=10; fontcolor="#7aa2f7";
    color="#3b4261"; style="rounded";
    vu [label="user processes  (VU)"];
    vs [label="guest kernel  (VS)\nown stage-1 page tables"];
    vu -> vs [label="syscall (delegated)"];
  }

  hv [label="Hypervisor  (H mode)\nstage-2 tables - scheduler - trap-and-emulate - manager console",
      fillcolor="#1a2233", color="#7aa2f7"];
  hw [label="Machine runtime\nRAM - console UART - TB32 CPU core",
      fillcolor="#18241a", color="#9ece6a"];

  vs -> hv [label="privileged op / device access  ->  trap"];
  hv -> hw [label="executes on"];

  subgraph cluster_xlate {
    label="every guest memory access is translated twice";
    labelloc="b"; fontname="Helvetica"; fontsize=10; fontcolor="#565f89";
    color="#2a2e3a"; style="rounded";
    gv [label="guest-virtual", shape=oval, fillcolor="#11141c"];
    gp [label="guest-physical", shape=oval, fillcolor="#11141c"];
    hp [label="host-physical", shape=oval, fillcolor="#11141c"];
    { rank=same; gv -> gp [label="guest page tables"]; gp -> hp [label="hypervisor stage-2"]; }
  }

  hw -> gv [style=invis];
}
